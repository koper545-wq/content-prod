# Database (Vercel Postgres)
DATABASE_URL=

# Auth (generate with: openssl rand -base64 64)
NEXTAUTH_SECRET=

# Email (Resend — https://resend.com)
RESEND_API_KEY=
EMAIL_FROM=noreply@content.pl

# Error Monitoring (Sentry — https://sentry.io)
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=

# Demo Mode (set to "true" to enable demo login and seed endpoints)
DEMO_ENABLED=false
NEXT_PUBLIC_DEMO_ENABLED=false
